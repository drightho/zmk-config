#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  | N1 | N2 |  N3  |  N4  |  N5  |       |  |      |  N6  |  N7 |   N8  |  N9 |  N0  | MINUS |
// |  TAB  | Q  | W  |  E   |  R   |  T   |       |  |      |  Y   |  U  |   I   |  O  |  P   | EQUAL |
// | LCTRL | A  | S  |  D   |  F   |  G   |       |  |      |  H   |  J  |   K   |  L  | SEMI |  SQT  |
// | LSHFT | Z  | X  |  C   |  V   |  B   |  LBKT |  | RBKT |  N   |  M  | COMMA | DOT | FSLH | RSHFT |
// |       |    |    | CAPS | LGUI | LALT | SPACE |  | RET  | RALT | MO2 |  BSPC |     |      |       |
            display-name = "Base";
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                        &kp N6   &kp N7 &kp N8    &kp N9  &kp N0   &kp MINUS
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                         &kp Y    &kp U  &kp I     &kp O   &kp P    &kp EQUAL
&kp LCTRL &kp A  &kp S  &kp D    &kp F    &kp G                         &kp H    &kp J  &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B    &kp LBKT    &kp RBKT &kp N    &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &kp CAPS &kp LGUI &kp LALT &kp SPACE   &kp RET  &kp RALT &mo 2  &kp BSPC
            >;
        };

        lower_layer {
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT0  | BT1 | BT2  |  BT3   |  BT4  |  |  |  |       |       |           |      | PSCRN | PAUSE_BREAK |
// |   F1  |  F2  |  F3 |  F4  |   F5   |   F6  |  |  |  |   F7  |   F8  |     F9    | F10  |  F11  |     F12     |
// | GRAVE | EXCL |  AT | HASH | DOLLAR | PRCNT |  |  |  | CARET |  AMPS | LS(KP_N8) | LPAR |  RPAR |    TILDE    |
// |       |      |     |      |        |       |  |  |  |       | MINUS |  KP_PLUS  | LBRC |  RBRC |     PIPE    |
// |       |      |     |      |        |       |  |  |  |       |       |           |      |       |             |
            display-name = "Lower";
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                 &trans    &trans    &trans        &trans   &kp PSCRN &kp PAUSE_BREAK
&kp F1     &kp F2       &kp F3       &kp F4       &kp F5       &kp F6                       &kp F7    &kp F8    &kp F9        &kp F10  &kp F11   &kp F12
&kp GRAVE  &kp EXCL     &kp AT       &kp HASH     &kp DOLLAR   &kp PRCNT                    &kp CARET &kp AMPS  &kp LS(KP_N8) &kp LPAR &kp RPAR  &kp TILDE
&trans     &trans       &trans       &trans       &trans       &trans       &trans   &trans &trans    &kp MINUS &kp KP_PLUS   &kp LBRC &kp RBRC  &kp PIPE
                                     &trans       &trans       &trans       &trans   &trans &trans    &trans    &trans
            >;
        };

        raise_layer {
// ------------------------------------------------------------------------------------------------------------
// |  BSLH | PIPE | GRAVE | TILDE |     |      |  |  |  |         |       |       |       |       |       |
// | GRAVE |  N1  |   N2  |   N3  |  N4 |  N5  |  |  |  |    N6   |   N7  |   N8  |   N9  |   N0  |       |
// |   F1  |  F2  |   F3  |   F4  |  F5 |  F6  |  |  |  |   LEFT  |  DOWN |   UP  | RIGHT | GRAVE | TILDE |
// |   F7  |  F8  |   F9  |  F10  | F11 | F12  |  |  |  | KP_PLUS | MINUS | EQUAL |       |  BSLH |  PIPE |
// |       |      |       |       |     | LALT |  |  |  |  K_APP  |       |  DEL  |       |       |       |
            display-name = "Raise";
            bindings = <
&kp BSLH  &kp PIPE &kp GRAVE &kp TILDE &trans  &trans                   &trans      &trans    &trans    &trans    &trans    &trans
&kp GRAVE &kp N1   &kp N2    &kp N3    &kp N4  &kp N5                   &kp N6      &kp N7    &kp N8    &kp N9    &kp N0    &trans
&kp F1    &kp F2   &kp F3    &kp F4    &kp F5  &kp F6                   &kp LEFT    &kp DOWN  &kp UP    &kp RIGHT &kp GRAVE &kp TILDE
&kp F7    &kp F8   &kp F9    &kp F10   &kp F11 &kp F12  &trans   &trans &kp KP_PLUS &kp MINUS &kp EQUAL &trans    &kp BSLH  &kp PIPE
                             &trans    &trans  &kp LALT &trans   &trans &kp K_APP   &trans    &kp DEL
            >;
        };
    };
};
